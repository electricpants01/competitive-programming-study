---
import { getLang, useTranslations, getLocalizedUrl, SUPPORTED_LANGS } from '../../../i18n/utils';
import type { Lang } from '../../../i18n/utils';

export function getStaticPaths() {
  return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const enUrl = getLocalizedUrl(Astro.url, 'en');
const esUrl = getLocalizedUrl(Astro.url, 'es');

// Normalize BASE_URL to always have a trailing slash — used for static asset paths
// (nav / lang-switcher use enUrl/esUrl directly; getLocalizedUrl already includes the base)
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!DOCTYPE html>
<html lang={lang} data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    {lang === 'es' ? 'Guía de Programación Competitiva' : 'CP Study Guide — Competitive Programming'}
  </title>
  <meta name="description" content={
    lang === 'es'
      ? 'Guía estructurada de algoritmos, estructuras de datos y técnicas para programación competitiva.'
      : 'A structured guide to algorithms, data structures and techniques for competitive programming.'
  } />
  <!-- Alternate hreflang for SEO -->
  <link rel="alternate" hreflang="en" href={new URL(enUrl, Astro.url).href} />
  <link rel="alternate" hreflang="es" href={new URL(esUrl, Astro.url).href} />
  <link rel="preload" href={base + 'fonts/GeistPixel-Square.woff2'} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={base + 'fonts/GeistMono-Variable.woff2'} as="font" type="font/woff2" crossorigin />
  <!-- Inject translations into window for script.js -->
  <script is:inline define:vars={{ translations: JSON.stringify(t), currentLang: lang, cpBase: base }}>
    window.__CP_LANG__ = currentLang;
    window.__CP_T__ = JSON.parse(translations);
    window.__CP_BASE__ = cpBase;
  </script>
  <style is:global>
    /* ============================================================
       Design System — alg0-inspired (ADR-0009)
    ============================================================ */
    @font-face {
      font-family: "Geist Pixel Square";
      src: url("/competitive-programming-study/fonts/GeistPixel-Square.woff2") format("woff2");
      font-display: swap;
      font-weight: 100 900;
    }
    @font-face {
      font-family: "Geist Mono";
      src: url("/competitive-programming-study/fonts/GeistMono-Variable.woff2") format("woff2");
      font-display: swap;
      font-weight: 100 900;
    }
    :root {
      --font-sans: "Geist Pixel Square", system-ui, -apple-system, sans-serif;
      --font-mono: "Geist Mono", ui-monospace, monospace;
      --font-heading: var(--font-sans);

      --surface: #000;
      --foreground: #fff;
      --muted: #737373;
      --muted-strong: #a3a3a3;
      --subtle: #ffffff0a;
      --subtle-strong: #ffffff14;
      --subtle-hover: #ffffff14;
      --border: #ffffff14;
      --accent: #38bdf8;
      --action-bg: #fff;
      --action-fg: #000;
      --danger: #f87171;
      --success: #4ade80;

      --header-height: 48px;
      --sidebar-width: 260px;
      --radius-sm: 6px;
      --radius-md: 10px;
      --radius-lg: 14px;
      --transition: 150ms ease;

      /* Legacy aliases used by feature CSS */
      --color-primary: var(--action-bg);
      --color-primary-dark: #e5e5e5;
      --color-primary-light: var(--subtle-strong);
      --bg-body: var(--surface);
      --bg-surface: #0a0a0a;
      --bg-sidebar: var(--surface);
      --bg-nav: var(--surface);
      --bg-code: #0a0a0a;
      --bg-hover: var(--subtle-hover);
      --bg-active: var(--subtle-strong);
      --text-primary: var(--foreground);
      --text-secondary: var(--muted-strong);
      --text-muted: var(--muted);
      --shadow-sm: none;
      --shadow-md: none;
      --nav-height: var(--header-height);
    }
    [data-theme="light"] {
      --surface: #fff;
      --foreground: #171717;
      --muted: #737373;
      --muted-strong: #525252;
      --subtle: #00000009;
      --subtle-strong: #00000014;
      --subtle-hover: #0000000d;
      --border: #00000014;
      --accent: #0284c7;
      --action-bg: #171717;
      --action-fg: #fff;
      --danger: #dc2626;
      --success: #16a34a;
      --bg-surface: #fafafa;
      --bg-code: #f5f5f5;
      --color-primary-light: #00000009;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; }
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--font-sans);
      font-size: 13px;
      line-height: 1.55;
      color: var(--foreground);
      background: var(--surface);
      -webkit-font-smoothing: antialiased;
      overflow: hidden;
    }

    /* ── App shell ── */
    .site-app {
      height: 100%;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .site-header {
      height: var(--header-height);
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 0 12px;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      z-index: 50;
      color: var(--foreground);
    }
    @media (min-width: 768px) {
      .site-header { padding: 0 20px; }
    }
    .site-header-left, .site-header-right {
      display: flex; align-items: center; gap: 8px; min-width: 0;
    }
    .site-header-right { flex-shrink: 0; }
    .header-icon-btn {
      width: 1.75rem; height: 1.75rem;
      display: inline-flex; align-items: center; justify-content: center;
      color: var(--muted); background: transparent; border: none;
      border-radius: var(--radius-sm); cursor: pointer;
      transition: color var(--transition), background var(--transition), transform var(--transition);
    }
    .header-icon-btn:hover { color: var(--foreground); background: var(--subtle-hover); }
    .header-icon-btn:active { transform: scale(0.97); }
    .header-logo {
      width: 1.5rem; height: 1.5rem; border-radius: var(--radius-sm);
      background: var(--action-bg); color: var(--action-fg);
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .header-brand {
      display: flex; align-items: center; gap: 8px;
      text-decoration: none; color: var(--foreground); font-weight: 600;
      font-size: 13px; min-width: 0;
    }
    .header-brand:hover { opacity: 0.75; }
    .header-crumb {
      font-size: 12px; color: var(--muted); white-space: nowrap;
      overflow: hidden; text-overflow: ellipsis; max-width: 220px;
    }
    .header-crumb:empty { display: none; }
    .lang-switcher {
      display: flex; align-items: center; gap: 4px;
      font-size: 12px; font-weight: 600;
    }
    .lang-btn {
      color: var(--muted); text-decoration: none; padding: 2px 6px;
      border-radius: 4px;
    }
    .lang-btn.active, .lang-btn:hover { color: var(--foreground); }
    .lang-divider { color: var(--border); }

    .site-body {
      flex: 1; display: flex; min-height: 0; position: relative;
    }
    .site-sidebar-backdrop {
      display: none; position: fixed; inset: 0; background: rgba(0,0,0,.6); z-index: 40;
    }
    .site-sidebar-backdrop.is-open { display: block; }
    @media (min-width: 768px) {
      .site-sidebar-backdrop { display: none !important; }
    }
    .site-sidebar {
      width: var(--sidebar-width);
      flex-shrink: 0;
      background: var(--surface);
      border-right: 1px solid var(--border);
      overflow: hidden;
      display: flex; flex-direction: column;
      z-index: 45;
    }
    .site-sidebar-inner {
      flex: 1; overflow-y: auto; padding: 8px 8px 24px;
    }
    .site-sidebar-progress {
      padding: 8px 10px 12px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 6px;
    }
    .progress-track {
      height: 3px; background: var(--subtle-strong); border-radius: 2px; overflow: hidden;
    }
    .progress-fill { height: 100%; background: var(--action-bg); width: 0; transition: width .3s ease; }
    .progress-label { font-size: 11px; color: var(--muted); margin-top: 6px; }

    .site-sidebar-section { margin-bottom: 4px; }
    .site-sidebar-section > summary {
      list-style: none; cursor: pointer;
      display: flex; align-items: center; justify-content: space-between;
      padding: 8px 10px; font-size: 11px; font-weight: 600;
      text-transform: uppercase; letter-spacing: .08em;
      color: var(--muted); border-radius: var(--radius-sm);
      transition: color var(--transition), background var(--transition);
    }
    .site-sidebar-section > summary::-webkit-details-marker { display: none; }
    .site-sidebar-section > summary:hover { color: var(--muted-strong); background: var(--subtle); }
    .site-sidebar-chevron {
      width: 12px; height: 12px; color: var(--muted); transition: transform .2s;
    }
    .site-sidebar-section[open] > summary .site-sidebar-chevron { transform: rotate(90deg); }
    .site-sidebar-item {
      width: 100%; display: flex; align-items: center; justify-content: space-between;
      gap: 8px; text-align: left; border: none; background: transparent; cursor: pointer;
      padding: 6px 10px 6px 12px; margin: 1px 0;
      font-family: inherit; font-size: 13px; color: var(--muted);
      border-radius: var(--radius-sm);
      transition: color var(--transition), background var(--transition);
    }
    .site-sidebar-item:hover { color: var(--muted-strong); background: var(--subtle); }
    .site-sidebar-item.active { color: var(--foreground); background: var(--subtle-strong); }
    .sidebar-new-badge {
      font-size: 9px; font-weight: 700; letter-spacing: .04em;
      padding: 1px 5px; border-radius: 4px;
      background: var(--action-bg); color: var(--action-fg);
    }

    @media (max-width: 767px) {
      .site-sidebar {
        position: fixed; top: var(--header-height); bottom: 0; left: 0;
        transform: translateX(-105%); transition: transform .2s ease;
      }
      .site-sidebar.is-open { transform: translateX(0); }
    }

    .site-main {
      flex: 1; min-width: 0; overflow: auto;
      display: flex; flex-direction: column;
      position: relative;
    }
    .site-main-inner { padding: 20px 16px 48px; max-width: 1100px; width: 100%; margin: 0 auto; }
    @media (min-width: 768px) {
      .site-main-inner { padding: 28px 28px 64px; }
    }

    [data-view] { display: none; }
    [data-view].active { display: block; }
    .page-section { display: none; }
    .page-section.active { display: block; }

    /* Home hero */
    .home-hero {
      text-align: center; max-width: 36rem; margin: 12vh auto 40px; padding: 0 12px;
    }
    .home-hero h1 {
      font-family: var(--font-heading); font-size: 20px; font-weight: 600;
      letter-spacing: -0.02em; color: var(--foreground); margin-bottom: 10px;
    }
    .home-hero p {
      font-size: 13px; color: var(--muted); line-height: 1.6; margin-bottom: 20px;
    }
    .home-cta {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 8px 16px; border-radius: var(--radius-sm); border: none; cursor: pointer;
      background: var(--action-bg); color: var(--action-fg);
      font-family: inherit; font-size: 13px; font-weight: 600;
      transition: opacity var(--transition);
    }
    .home-cta:hover { opacity: 0.88; }
    .home-section-title {
      font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .08em;
      color: var(--muted); margin: 36px 0 14px;
    }

    /* Search overlay */
    .nav-search {
      display: flex; align-items: center; gap: 6px;
      background: var(--subtle); border: 1px solid var(--border);
      border-radius: var(--radius-sm); padding: 4px 8px; min-width: 140px;
    }
    .nav-search input {
      border: none; background: transparent; color: var(--foreground);
      font-family: inherit; font-size: 12px; outline: none; width: 120px;
    }
    .nav-search input::placeholder { color: var(--muted); }
    .nav-search-clear { border: none; background: transparent; color: var(--muted); cursor: pointer; display: none; }
    .nav-search.has-value .nav-search-clear { display: inline-flex; }
    .search-overlay {
      display: none; position: absolute; inset: 0; z-index: 30;
      background: color-mix(in srgb, var(--surface) 92%, transparent);
      padding: 16px;
    }
    .search-overlay.visible { display: block; }
    .search-panel {
      max-width: 640px; margin: 0 auto; background: var(--bg-surface);
      border: 1px solid var(--border); border-radius: var(--radius-md); overflow: hidden;
    }
    .search-result-item {
      display: block; width: 100%; text-align: left; border: none; background: transparent;
      padding: 10px 14px; cursor: pointer; color: var(--foreground); font-family: inherit;
      border-bottom: 1px solid var(--border);
    }
    .search-result-item:hover { background: var(--subtle); }

    /* Cards / grids — remapped to tokens */
    .algo-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 10px;
    }
    .algo-card {
      background: var(--subtle); border: 1px solid var(--border);
      border-radius: var(--radius-md); padding: 14px; cursor: pointer;
      transition: border-color var(--transition), background var(--transition);
    }
    .algo-card:hover { border-color: color-mix(in srgb, var(--foreground) 25%, transparent); background: var(--subtle-strong); }
    .algo-card-title { font-size: 14px; font-weight: 600; color: var(--foreground); margin-bottom: 6px; }
    .algo-card-desc {
      font-size: 12px; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 2;
      -webkit-box-orient: vertical; overflow: hidden;
    }
    .algo-badges { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 8px; }
    .badge {
      font-size: 10px; font-weight: 600; padding: 2px 7px; border-radius: 999px;
      border: 1px solid var(--border); color: var(--muted-strong);
    }
    .badge-beginner { color: var(--success); }
    .badge-advanced { color: var(--danger); }

    .stat-card, .quick-card, .tool-card, .intro-card, .roadmap-phase, .lp-item, .detail-card {
      background: var(--subtle); border: 1px solid var(--border); border-radius: var(--radius-md);
    }
    .section-title, .section-header h2 {
      font-size: 18px; font-weight: 600; color: var(--foreground); letter-spacing: -0.02em;
    }
    .section-subtitle { font-size: 13px; color: var(--muted); margin-top: 4px; }

    .detail-back-btn {
      display: inline-flex; align-items: center; gap: 6px; margin-bottom: 16px;
      background: transparent; border: 1px solid var(--border); color: var(--muted-strong);
      padding: 6px 10px; border-radius: var(--radius-sm); cursor: pointer; font-family: inherit; font-size: 12px;
    }
    .detail-back-btn:hover { color: var(--foreground); background: var(--subtle); }

    .code-block, .code-example, pre, code, .ip-ascii {
      font-family: var(--font-mono) !important;
    }
    .code-example {
      background: var(--bg-code); border: 1px solid var(--border); border-radius: var(--radius-md);
      overflow: hidden; margin: 12px 0;
    }
    .code-block {
      padding: 14px 16px; overflow-x: auto; font-size: 12px; line-height: 1.55; color: var(--foreground);
    }
    .modal-section-title {
      font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin: 20px 0 10px;
    }
    .tag, .problem-chip, .cf-tag, .vl-tag, .vl-badge, .ip-badge, .ip-filter-btn {
      border: 1px solid var(--border) !important;
      background: var(--subtle) !important;
      color: var(--muted-strong) !important;
    }
    .cf-tag.selected, .vl-tag.selected, .ip-filter-btn.active, .cf-mode-btn.active, .cf-sort-btn.active, .cf-tab.active {
      background: var(--action-bg) !important;
      border-color: var(--action-bg) !important;
      color: var(--action-fg) !important;
    }
    .cf-search-submit, .home-cta, .ip-btn-primary {
      background: var(--action-bg) !important;
      color: var(--action-fg) !important;
      border-color: var(--action-bg) !important;
    }
    .cf-problem-card, .vl-card, .ip-card {
      background: var(--subtle) !important;
      border: 1px solid var(--border) !important;
    }
    .cf-rating-input, .vl-query-input {
      background: var(--subtle) !important;
      border: 1px solid var(--border) !important;
      color: var(--foreground) !important;
    }
    .quiz-option {
      background: var(--subtle); border: 1px solid var(--border); color: var(--foreground);
    }
    .quiz-option.selected { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 15%, transparent); }
    .quiz-option.correct { border-color: var(--success); color: var(--success); }
    .quiz-option.wrong { border-color: var(--danger); color: var(--danger); }
    .quiz-submit-btn {
      background: var(--action-bg); color: var(--action-fg); border: none;
      padding: 8px 14px; border-radius: var(--radius-sm); font-family: inherit; cursor: pointer;
    }

    /* Keep remaining feature layout rules below — colors inherit tokens */

    /* Legacy top-nav/layout/sidebar rules removed — see .site-* shell above */

    /* ── Codeforces Problem Search ── */
    .cf-tabs {
      display: flex; gap: 4px; margin-bottom: 24px;
      border-bottom: 2px solid var(--border); padding-bottom: 0;
    }
    .cf-tab {
      padding: 8px 20px; font-size: 13.5px; font-weight: 600;
      background: none; border: none; cursor: pointer;
      color: var(--text-secondary); border-radius: var(--radius-sm) var(--radius-sm) 0 0;
      border-bottom: 2px solid transparent; margin-bottom: -2px;
      transition: color var(--transition), border-color var(--transition), background var(--transition);
    }
    .cf-tab:hover { color: var(--text-primary); background: var(--bg-hover); }
    .cf-tab.active { color: var(--color-primary); border-bottom-color: var(--color-primary); }
    .cf-tag-section { margin-bottom: 20px; }
    .cf-label { font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: .04em; margin-bottom: 10px; }
    .cf-tag-cloud { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
    .cf-tag {
      padding: 4px 10px; background: var(--bg-body); border: 1.5px solid var(--border);
      border-radius: 14px; font-size: 12px; font-weight: 500; color: var(--text-secondary);
      cursor: pointer; transition: background var(--transition), border-color var(--transition), color var(--transition);
    }
    .cf-tag:hover { border-color: var(--color-primary); color: var(--color-primary); }
    .cf-tag.selected { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
    .cf-clear-btn {
      font-size: 11.5px; color: var(--text-muted); background: none; border: none;
      cursor: pointer; padding: 2px 0; text-decoration: underline;
      transition: color var(--transition);
    }
    .cf-clear-btn:hover { color: var(--text-primary); }
    .cf-filters-row { display: flex; gap: 20px; flex-wrap: wrap; align-items: flex-end; margin-bottom: 20px; }
    .cf-filter-group { display: flex; flex-direction: column; gap: 6px; }
    .cf-rating-input {
      width: 80px; padding: 7px 10px; font-size: 13px;
      border: 1.5px solid var(--border); border-radius: var(--radius-sm);
      background: var(--bg-surface); color: var(--text-primary);
      transition: border-color var(--transition);
    }
    .cf-rating-input:focus { outline: none; border-color: var(--color-primary); }
    .cf-combine-toggle { display: flex; border: 1.5px solid var(--border); border-radius: var(--radius-sm); overflow: hidden; }
    .cf-mode-btn {
      padding: 7px 14px; font-size: 12.5px; font-weight: 600;
      background: var(--bg-surface); border: none; cursor: pointer;
      color: var(--text-secondary);
      transition: background var(--transition), color var(--transition);
    }
    .cf-mode-btn:hover { background: var(--bg-hover); color: var(--text-primary); }
    .cf-mode-btn.active { background: var(--color-primary); color: #fff; }
    .cf-search-submit {
      padding: 8px 22px; background: var(--color-primary); color: #fff;
      border: none; border-radius: var(--radius-sm); font-size: 13.5px;
      font-weight: 600; cursor: pointer;
      transition: opacity var(--transition);
    }
    .cf-search-submit:hover { opacity: 0.88; }
    .cf-status {
      padding: 12px 16px; border-radius: var(--radius-sm); font-size: 13px;
      margin-bottom: 16px; background: var(--bg-surface); border: 1px solid var(--border);
      color: var(--text-secondary);
    }
    .cf-status.error { border-color: #dc2626; color: #dc2626; background: #fee2e2; }
    [data-theme="dark"] .cf-status.error { background: #450a0a; }
    .cf-retry-btn {
      margin-left: 10px; padding: 4px 10px; font-size: 12px; font-weight: 600;
      border: 1.5px solid currentColor; border-radius: var(--radius-sm);
      background: transparent; color: inherit; cursor: pointer;
    }
    .cf-retry-btn:hover { opacity: 0.85; }
    .cf-sort-row { display: flex; gap: 6px; align-items: center; margin-bottom: 12px; flex-wrap: wrap; }
    .cf-sort-btn {
      padding: 5px 12px; font-size: 12px; font-weight: 600;
      background: var(--bg-surface); border: 1.5px solid var(--border);
      border-radius: 14px; cursor: pointer; color: var(--text-secondary);
      transition: border-color var(--transition), color var(--transition), background var(--transition);
    }
    .cf-sort-btn:hover { border-color: var(--color-primary); color: var(--color-primary); }
    .cf-sort-btn.active { border-color: var(--color-primary); color: var(--color-primary); background: var(--color-primary-light); }
    .cf-count { font-size: 12.5px; color: var(--text-muted); margin-bottom: 12px; }
    .cf-results-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: 20px; }
    .cf-problem-card {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      padding: 12px 16px; background: var(--bg-surface); border: 1px solid var(--border);
      border-radius: var(--radius-md); flex-wrap: wrap;
      transition: box-shadow var(--transition), border-color var(--transition), background var(--transition);
    }
    .cf-problem-card:hover { box-shadow: var(--shadow-sm); border-color: var(--color-primary); }
    .cf-problem-card.solved { border-left: 3px solid #16a34a; }
    .cf-problem-info { flex: 1; min-width: 0; }
    .cf-problem-title { font-size: 13.5px; font-weight: 600; color: var(--text-primary); margin-bottom: 4px; }
    .cf-problem-meta { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .cf-problem-tag {
      padding: 2px 8px; background: var(--color-primary-light); color: var(--color-primary);
      border-radius: 10px; font-size: 11px; font-weight: 500;
    }
    .cf-problem-rating {
      font-size: 12px; font-weight: 700; color: var(--text-muted);
      background: var(--bg-body); padding: 2px 8px; border-radius: 10px;
    }
    .cf-problem-solved-badge {
      font-size: 11px; font-weight: 600; color: #16a34a;
    }
    .cf-problem-actions { display: flex; gap: 6px; align-items: center; flex-shrink: 0; }
    .cf-action-btn {
      padding: 5px 10px; font-size: 11.5px; font-weight: 600;
      border-radius: var(--radius-sm); border: 1.5px solid var(--border);
      background: var(--bg-body); color: var(--text-secondary);
      cursor: pointer; white-space: nowrap;
      transition: border-color var(--transition), color var(--transition), background var(--transition);
      text-decoration: none; display: inline-flex; align-items: center;
    }
    .cf-action-btn:hover { border-color: var(--color-primary); color: var(--color-primary); }
    .cf-action-btn.fav-active { border-color: #f59e0b; color: #f59e0b; }
    .cf-action-btn.solved-active { border-color: #16a34a; color: #16a34a; }
    .cf-pagination { display: flex; gap: 6px; align-items: center; justify-content: center; flex-wrap: wrap; }
    .cf-page-btn {
      padding: 6px 12px; font-size: 12.5px; font-weight: 600;
      background: var(--bg-surface); border: 1.5px solid var(--border);
      border-radius: var(--radius-sm); cursor: pointer; color: var(--text-secondary);
      transition: border-color var(--transition), color var(--transition), background var(--transition);
    }
    .cf-page-btn:hover { border-color: var(--color-primary); color: var(--color-primary); }
    .cf-page-btn.active { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
    .cf-page-btn:disabled { opacity: 0.4; cursor: default; }

    /* ── Video Library ── */
    .section-header { margin-bottom: 24px; }
    .section-header h2 { font-size: 22px; font-weight: 800; color: var(--text-primary); margin-bottom: 6px; }
    .section-subtitle { font-size: 13.5px; color: var(--text-secondary); }
    .vl-channel-row { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 20px; }
    .vl-channel-btn {
      padding: 6px 14px; font-size: 12.5px; font-weight: 600;
      background: var(--bg-surface); border: 1.5px solid var(--border);
      border-radius: 20px; cursor: pointer; color: var(--text-secondary);
      transition: border-color var(--transition), color var(--transition), background var(--transition);
    }
    .vl-channel-btn:hover { border-color: var(--color-primary); color: var(--color-primary); }
    .vl-channel-btn.active { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
    .vl-search-bar { margin-bottom: 16px; }
    .vl-query-input {
      width: 100%; padding: 10px 16px; font-size: 14px;
      border: 1.5px solid var(--border); border-radius: var(--radius-md);
      background: var(--bg-surface); color: var(--text-primary);
      transition: border-color var(--transition);
    }
    .vl-query-input:focus { outline: none; border-color: var(--color-primary); }
    .vl-tag-row { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
    .vl-tags-label { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--text-muted); }
    .vl-tag-cloud { display: flex; flex-wrap: wrap; gap: 6px; }
    .vl-tag {
      padding: 4px 10px; background: var(--bg-body); border: 1.5px solid var(--border);
      border-radius: 12px; font-size: 11.5px; font-weight: 500; color: var(--text-secondary);
      cursor: pointer; transition: background var(--transition), border-color var(--transition), color var(--transition);
    }
    .vl-tag:hover { border-color: var(--color-primary); color: var(--color-primary); }
    .vl-tag.selected { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
    .vl-clear-btn {
      font-size: 11.5px; color: var(--text-muted); background: none; border: none;
      cursor: pointer; text-decoration: underline; transition: color var(--transition);
    }
    .vl-clear-btn:hover { color: var(--text-primary); }
    .vl-results { display: flex; flex-direction: column; gap: 12px; }
    .vl-card {
      display: flex; gap: 14px; padding: 14px 16px;
      background: var(--bg-surface); border: 1px solid var(--border);
      border-radius: var(--radius-md); align-items: flex-start;
      transition: box-shadow var(--transition), border-color var(--transition);
    }
    .vl-card:hover { box-shadow: var(--shadow-md); border-color: var(--color-primary); }
    .vl-thumb-link { position: relative; flex-shrink: 0; display: block; }
    .vl-thumb { width: 160px; height: 90px; object-fit: cover; border-radius: var(--radius-sm); display: block; }
    .vl-duration-badge {
      position: absolute; bottom: 4px; right: 4px;
      background: rgba(0,0,0,.75); color: #fff;
      font-size: 10.5px; font-weight: 700; padding: 1px 5px;
      border-radius: 4px; pointer-events: none;
    }
    .vl-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
    .vl-title {
      font-size: 14px; font-weight: 700; color: var(--text-primary); text-decoration: none;
      line-height: 1.4;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
    .vl-title:hover { color: var(--color-primary); }
    .vl-meta { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
    .vl-channel { font-size: 12px; font-weight: 600; color: var(--text-secondary); }
    .vl-badge {
      padding: 2px 7px; background: var(--color-primary-light); color: var(--color-primary);
      border-radius: 9px; font-size: 10.5px; font-weight: 500;
    }
    .vl-match-count { font-size: 11.5px; font-weight: 600; color: #d97706; }
    .vl-no-transcript { font-size: 11.5px; color: var(--text-muted); font-style: italic; }
    .vl-open {
      font-size: 11.5px; font-weight: 600; color: var(--color-primary); text-decoration: none; margin-left: auto;
    }
    .vl-open:hover { text-decoration: underline; }
    .vl-segments { display: flex; flex-direction: column; gap: 6px; margin-top: 4px; }
    .vl-segment {
      display: flex; gap: 8px; align-items: flex-start;
      padding: 6px 10px; background: var(--bg-body); border: 1px solid var(--border);
      border-radius: var(--radius-sm); text-decoration: none;
      transition: border-color var(--transition), background var(--transition);
    }
    .vl-segment:hover { border-color: var(--color-primary); background: var(--color-primary-light); }
    .vl-seg-ts { font-size: 11.5px; font-weight: 700; color: var(--color-primary); white-space: nowrap; flex-shrink: 0; }
    .vl-seg-text { font-size: 12px; color: var(--text-secondary); line-height: 1.5; }
    @media (max-width: 600px) {
      .vl-thumb { width: 100px; height: 56px; }
      .vl-card { gap: 10px; padding: 10px 12px; }
    }

    /* ── ICPC Prelims ─────────────────────────────────────────── */
    .ip-filter-row {
      display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px;
    }
    .ip-filter-btn {
      padding: 6px 12px; background: var(--bg-body); border: 1.5px solid var(--border);
      border-radius: 12px; font-size: 12px; font-weight: 600; color: var(--text-secondary);
      cursor: pointer; transition: background var(--transition), border-color var(--transition), color var(--transition);
    }
    .ip-filter-btn:hover { border-color: var(--color-primary); color: var(--color-primary); }
    .ip-filter-btn.active {
      background: var(--color-primary); border-color: var(--color-primary); color: #fff;
    }
    .ip-count {
      font-size: 12.5px; color: var(--text-muted); margin-bottom: 12px; display: none;
    }
    .ip-results { display: flex; flex-direction: column; gap: 10px; }
    .ip-empty {
      padding: 24px; color: var(--text-muted); text-align: center;
    }
    .ip-card {
      display: flex; gap: 14px; padding: 14px 16px;
      background: var(--bg-surface); border: 1px solid var(--border);
      border-radius: var(--radius-md); align-items: flex-start;
      transition: box-shadow var(--transition), border-color var(--transition);
    }
    .ip-card:hover { box-shadow: var(--shadow-md); border-color: var(--color-primary); }
    .ip-year {
      flex-shrink: 0; min-width: 56px; text-align: center;
      font-size: 15px; font-weight: 800; color: var(--color-primary);
      background: var(--color-primary-light); border-radius: var(--radius-sm);
      padding: 10px 8px;
    }
    .ip-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
    .ip-card-title {
      font-size: 14px; font-weight: 700; color: var(--text-primary); line-height: 1.35;
    }
    .ip-meta { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
    .ip-badge {
      padding: 2px 8px; background: var(--bg-body); border: 1px solid var(--border);
      border-radius: 9px; font-size: 10.5px; font-weight: 600; color: var(--text-secondary);
    }
    .ip-badge-kind {
      background: var(--color-primary-light); border-color: transparent; color: var(--color-primary);
    }
    .ip-source {
      font-size: 11.5px; font-weight: 600; color: var(--text-muted); text-decoration: none;
    }
    .ip-source:hover { color: var(--color-primary); text-decoration: underline; }
    .ip-notes { font-size: 12.5px; color: var(--text-secondary); line-height: 1.45; }
    .ip-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 2px; }
    .ip-btn {
      display: inline-flex; align-items: center; padding: 6px 12px;
      border: 1.5px solid var(--border); border-radius: var(--radius-sm);
      font-size: 12px; font-weight: 600; color: var(--text-secondary); text-decoration: none;
      background: var(--bg-body); transition: border-color var(--transition), color var(--transition), background var(--transition);
      cursor: pointer;
    }
    .ip-btn:hover { border-color: var(--color-primary); color: var(--color-primary); }
    .ip-btn-primary {
      background: var(--color-primary); border-color: var(--color-primary); color: #fff;
    }
    .ip-btn-primary:hover { opacity: 0.9; color: #fff; }
    .ip-editorial-overlay {
      position: fixed; inset: 0; z-index: 300;
      display: flex; align-items: center; justify-content: center;
      padding: 24px; background: rgba(15, 23, 42, .72);
    }
    .ip-editorial-overlay[hidden] { display: none; }
    .ip-editorial-dialog {
      width: min(960px, 100%); max-height: calc(100vh - 48px);
      overflow-y: auto; background: var(--bg-surface);
      border: 1px solid var(--border); border-radius: var(--radius-lg);
      box-shadow: 0 24px 64px rgba(0, 0, 0, .28);
    }
    .ip-editorial-header {
      position: sticky; top: 0; z-index: 1;
      display: flex; align-items: flex-start; justify-content: space-between; gap: 16px;
      padding: 20px 24px; background: var(--bg-surface);
      border-bottom: 1px solid var(--border);
    }
    .ip-editorial-heading { font-size: 20px; color: var(--text-primary); }
    .ip-editorial-note {
      margin-top: 5px; font-size: 12px; line-height: 1.5; color: var(--text-muted);
    }
    .ip-editorial-close {
      flex-shrink: 0; width: 34px; height: 34px; border-radius: 50%;
      border: 1px solid var(--border); background: var(--bg-body);
      color: var(--text-secondary); font-size: 20px; cursor: pointer;
    }
    .ip-editorial-close:hover { border-color: var(--color-primary); color: var(--color-primary); }
    .ip-editorial-list {
      display: flex; flex-direction: column; gap: 18px; padding: 24px;
    }
    .ip-editorial-problem {
      padding: 20px; border: 1px solid var(--border);
      border-radius: var(--radius-md); background: var(--bg-body);
    }
    .ip-editorial-problem-head {
      display: flex; align-items: center; justify-content: space-between;
      gap: 12px; flex-wrap: wrap; margin-bottom: 12px;
    }
    .ip-editorial-problem-title { font-size: 16px; color: var(--text-primary); }
    .ip-difficulty {
      padding: 4px 9px; border-radius: 12px; font-size: 11px; font-weight: 700;
      color: #92400e; background: #fef3c7;
    }
    [data-theme="dark"] .ip-difficulty { color: #fde68a; background: #451a03; }
    .ip-topic-row { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 14px; }
    .ip-editorial-section-title {
      margin: 16px 0 7px; font-size: 12px; font-weight: 800;
      letter-spacing: .04em; text-transform: uppercase; color: var(--text-muted);
    }
    .ip-ascii {
      overflow-x: auto; padding: 14px; border-radius: var(--radius-sm);
      background: #0f172a; color: #dbeafe;
      font-family: 'JetBrains Mono', monospace; font-size: 12px; line-height: 1.45;
    }
    .ip-insight, .ip-complexity {
      padding: 11px 13px; border-left: 3px solid var(--color-primary);
      border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
      background: var(--color-primary-light); color: var(--text-secondary);
      font-size: 13px; line-height: 1.55;
    }
    .ip-analysis {
      margin: 0; padding-left: 22px; color: var(--text-secondary);
      font-size: 13px; line-height: 1.6;
    }
    .ip-analysis li + li { margin-top: 5px; }
    @media (max-width: 600px) {
      .ip-editorial-overlay { padding: 8px; }
      .ip-editorial-dialog { max-height: calc(100vh - 16px); }
      .ip-editorial-header, .ip-editorial-list { padding: 16px; }
      .ip-editorial-problem { padding: 14px; }
    }
  </style>
</head>
<body>
<div class="site-app">
  <header class="site-header" role="banner">
    <div class="site-header-left">
      <button type="button" class="header-icon-btn" id="sidebar-toggle" aria-label="Menu">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M6.245 2.5H14.5V12.5a1 1 0 0 1-1 1H6.245V2.5ZM4.995 2.5H1.5V12.5a1 1 0 0 0 1 1h2.495V2.5ZM0 1h16v1.5V12.5A2.5 2.5 0 0 1 13.5 15h-11A2.5 2.5 0 0 1 0 12.5V2.5V1Z" clip-rule="evenodd"/></svg>
      </button>
      <a class="header-brand" href={`${base}${lang}/guide`} id="brand-home">
        <div class="header-logo" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" d="M10.5 2v2m3-2v2M8 6.5H6m2 3H6m12-3h-2m2 3h-2"/><rect x="8" y="4" width="8" height="8" rx="1.5"/></svg>
        </div>
        <span>{t.nav.brand}</span>
      </a>
      <span class="header-crumb" id="header-crumb"></span>
    </div>
    <div class="site-header-right">
      <div class="nav-search" id="nav-search-wrap">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input id="search-input" type="text" placeholder={t.nav.searchPlaceholder} autocomplete="off" spellcheck="false" />
        <button class="nav-search-clear" id="search-clear" aria-label="Clear search">×</button>
      </div>
      <div class="lang-switcher" role="navigation" aria-label="Language">
        <a class:list={['lang-btn', { active: lang === 'en' }]} href={enUrl} hreflang="en">EN</a>
        <span class="lang-divider" aria-hidden="true">|</span>
        <a class:list={['lang-btn', { active: lang === 'es' }]} href={esUrl} hreflang="es">ES</a>
      </div>
      <button class="header-icon-btn" id="theme-toggle" title={t.nav.toggleTheme}>
        <span id="theme-icon"></span>
      </button>
    </div>
  </header>

  <div class="site-body">
    <div class="site-sidebar-backdrop" id="sidebar-backdrop"></div>
    <aside class="site-sidebar" id="sidebar">
      <div class="site-sidebar-inner">
        <div class="site-sidebar-progress">
          <div class="progress-track"><div class="progress-fill" id="progress-fill" style="width:0%"></div></div>
          <div class="progress-label" id="progress-label">0%</div>
        </div>
        <div id="sidebar-nav"></div>
      </div>
    </aside>

    <main class="site-main" id="main-content">
      <div class="search-overlay" id="search-overlay">
        <div class="search-panel" id="search-results"></div>
      </div>
      <div class="site-main-inner">

      <!-- HOME -->
      <section class="page-section active" data-view="home" data-section="overview">
        <div class="home-hero">
          <h1>{t.overview.heroTitle.replace('\\n', ' ').replace('\n', ' ')}</h1>
          <p>{t.overview.heroSubtitle}</p>
          <button type="button" class="home-cta" id="home-cta-browse">{lang === 'es' ? 'Explorar algoritmos' : 'Browse algorithms'}</button>
        </div>

        <div class="home-section-title">{t.algorithms.title}</div>
        <div class="algo-grid" id="algo-grid"></div>

        <div style="margin-top:40px" id="overview-introduction">
          <h2 class="section-title" style="text-align:left;margin-bottom:16px">{t.overview.introTitle}</h2>
          <div class="intro-card" style="padding:16px">
            {t.overview.introBody.map(p => <p style="margin-bottom:10px;color:var(--muted-strong)">{p}</p>)}
          </div>
        </div>

        <div style="margin-top:32px" id="overview-learning-path">
          <h2 class="section-title" style="text-align:left;margin-bottom:16px">{t.overview.learningPathTitle}</h2>
          <div style="display:flex;flex-direction:column;gap:10px">
            {t.overview.learningPath.map(item => (
              <div class="lp-item" style="display:flex;gap:12px;padding:12px;align-items:flex-start">
                <div class="lp-number" style={`background:var(--action-bg);color:var(--action-fg);width:28px;height:28px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-weight:700;flex-shrink:0`}>{item.step}</div>
                <div>
                  <div class="lp-title" style="font-weight:600;color:var(--foreground)">{item.title}</div>
                  <div class="lp-desc" style="font-size:12px;color:var(--muted)">{item.desc}</div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div style="margin-top:40px" id="overview-assessment">
          <div class="home-section-title">{t.roadmap.title}</div>
          <p style="font-size:13px;color:var(--muted);margin-bottom:16px">{t.roadmap.subtitle}</p>
          <div class="roadmap-phases" style="display:flex;flex-direction:column;gap:12px">
            {t.roadmap.phases.map(phase => (
              <div class="roadmap-phase" style="padding:14px">
                <div class="roadmap-phase-header" style="display:flex;gap:12px;align-items:center;margin-bottom:10px">
                  <div class="phase-number" style="width:28px;height:28px;border-radius:6px;background:var(--action-bg);color:var(--action-fg);display:flex;align-items:center;justify-content:center;font-weight:700">{phase.number}</div>
                  <div>
                    <div class="phase-title" style="font-weight:600">{phase.title}</div>
                    <div class="phase-duration" style="font-size:12px;color:var(--muted)">{phase.duration}</div>
                  </div>
                </div>
                <div class="phase-body">
                  {phase.topics.map(topic => (
                    <div class="phase-topic" style="font-size:12px;color:var(--muted-strong);padding:3px 0">{topic}</div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

        <div style="margin-top:40px">
          <div class="home-section-title">{t.tools.title}</div>
          <p style="font-size:13px;color:var(--muted);margin-bottom:16px">{t.tools.subtitle}</p>
          <div class="tools-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px">
            <div class="tool-card" style="padding:14px"><div class="tool-card-title" style="font-weight:600;margin-bottom:6px">{t.tools.items.codeforces.title}</div><div class="tool-card-desc" style="font-size:12px;color:var(--muted);margin-bottom:8px">{t.tools.items.codeforces.desc}</div><a class="tool-card-link" style="color:var(--accent);font-size:12px" href="https://codeforces.com" target="_blank" rel="noopener">{t.tools.visitLabel}</a></div>
            <div class="tool-card" style="padding:14px"><div class="tool-card-title" style="font-weight:600;margin-bottom:6px">{t.tools.items.leetcode.title}</div><div class="tool-card-desc" style="font-size:12px;color:var(--muted);margin-bottom:8px">{t.tools.items.leetcode.desc}</div><a class="tool-card-link" style="color:var(--accent);font-size:12px" href="https://leetcode.com" target="_blank" rel="noopener">{t.tools.visitLabel}</a></div>
            <div class="tool-card" style="padding:14px"><div class="tool-card-title" style="font-weight:600;margin-bottom:6px">{t.tools.items.cpAlgorithms.title}</div><div class="tool-card-desc" style="font-size:12px;color:var(--muted);margin-bottom:8px">{t.tools.items.cpAlgorithms.desc}</div><a class="tool-card-link" style="color:var(--accent);font-size:12px" href="https://cp-algorithms.com" target="_blank" rel="noopener">{t.tools.visitLabel}</a></div>
            <div class="tool-card" style="padding:14px"><div class="tool-card-title" style="font-weight:600;margin-bottom:6px">{t.tools.items.usacoGuide.title}</div><div class="tool-card-desc" style="font-size:12px;color:var(--muted);margin-bottom:8px">{t.tools.items.usacoGuide.desc}</div><a class="tool-card-link" style="color:var(--accent);font-size:12px" href="https://usaco.guide" target="_blank" rel="noopener">{t.tools.visitLabel}</a></div>
          </div>
        </div>
      </section>

      <!-- TOPIC -->
      <section class="page-section" data-view="topic" data-section="detail">
        <button class="detail-back-btn" id="detail-back">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
          {lang === 'es' ? 'Volver' : 'Back'}
        </button>
        <div id="detail-panel"></div>
      </section>

<!-- ══ SEARCH PROBLEMS ══ -->
    <section class="page-section" data-view="search">
      <div style="margin-bottom:24px">
        <h2 style="font-size:22px;font-weight:800;color:var(--text-primary);margin-bottom:6px">{t.search.title}</h2>
        <p style="font-size:13.5px;color:var(--text-secondary)">{t.search.subtitle}</p>
      </div>
      <!-- Tabs -->
      <div class="cf-tabs">
        <button class="cf-tab active" id="cf-tab-search">{t.search.searchTab}</button>
        <button class="cf-tab" id="cf-tab-favs">{t.search.favoritesTab}</button>
      </div>
      <!-- Search panel -->
      <div id="cf-search-panel">
        <div class="cf-tag-section">
          <div class="cf-label">{t.search.tagsLabel}</div>
          <div id="cf-tag-cloud" class="cf-tag-cloud"></div>
          <button id="cf-clear-tags" class="cf-clear-btn">{t.search.clearTags}</button>
        </div>
        <div class="cf-filters-row">
          <div class="cf-filter-group">
            <label class="cf-label">{t.search.difficultyLabel}</label>
            <div style="display:flex;gap:8px;align-items:center">
              <input id="cf-min-rating" class="cf-rating-input" type="number" placeholder={t.search.minRating} min="800" max="3500" step="100" value="800" />
              <span style="color:var(--text-secondary)">–</span>
              <input id="cf-max-rating" class="cf-rating-input" type="number" placeholder={t.search.maxRating} min="800" max="3500" step="100" value="2000" />
            </div>
          </div>
          <div class="cf-filter-group">
            <label class="cf-label">&nbsp;</label>
            <div class="cf-combine-toggle">
              <button class="cf-mode-btn active" id="cf-mode-and">{t.search.combineModeAnd}</button>
              <button class="cf-mode-btn" id="cf-mode-or">{t.search.combineModeOr}</button>
            </div>
          </div>
          <div class="cf-filter-group" style="align-self:flex-end">
            <button id="cf-search-btn" class="cf-search-submit">{t.search.searchBtn}</button>
          </div>
        </div>
        <div id="cf-status" class="cf-status" style="display:none"></div>
        <div id="cf-sort-row" class="cf-sort-row" style="display:none">
          <span style="font-size:12px;color:var(--text-secondary)">Sort:</span>
          <button class="cf-sort-btn active" id="cf-sort-rating">{t.search.sortByRating}</button>
          <button class="cf-sort-btn" id="cf-sort-rating-desc">{t.search.sortByRatingDesc}</button>
          <button class="cf-sort-btn" id="cf-sort-id">{t.search.sortById}</button>
        </div>
        <div id="cf-count" class="cf-count" style="display:none"></div>
        <div id="cf-results-list" class="cf-results-list"></div>
        <div id="cf-pagination" class="cf-pagination"></div>
      </div>
      <!-- Favorites panel -->
      <div id="cf-favs-panel" style="display:none">
        <div id="cf-favs-list" class="cf-results-list"></div>
      </div>
    </section>

    <!-- ── Video Library Section ────────────────────────────── -->
    <section class="page-section" data-view="videos">
      <div class="section-header">
        <h2 id="vl-title"></h2>
        <p id="vl-subtitle" class="section-subtitle"></p>
      </div>

      <!-- Channel filter row -->
      <div id="vl-channel-row" class="vl-channel-row"></div>

      <!-- Search bar -->
      <div class="vl-search-bar">
        <input id="vl-query" type="text" class="vl-query-input" />
      </div>

      <!-- Tag cloud -->
      <div class="vl-tag-row">
        <span class="vl-tags-label" id="vl-tags-label"></span>
        <div id="vl-tag-cloud" class="vl-tag-cloud"></div>
        <button id="vl-clear-tags" class="vl-clear-btn"></button>
      </div>

      <!-- Results -->
      <div id="vl-results" class="vl-results"></div>
    </section>

    <!-- ── ICPC Preliminaries Section ───────────────────────── -->
    <section class="page-section" data-view="icpc-prelims">
      <div class="section-header">
        <h2 id="ip-title"></h2>
        <p id="ip-subtitle" class="section-subtitle"></p>
      </div>
      <div id="ip-region-row" class="ip-filter-row"></div>
      <div id="ip-kind-row" class="ip-filter-row"></div>
      <div id="ip-count" class="ip-count"></div>
      <div id="ip-results" class="ip-results"></div>
      <div
        id="ip-editorial-overlay"
        class="ip-editorial-overlay"
        role="dialog"
        aria-modal="true"
        aria-labelledby="ip-editorial-title"
        hidden
      >
        <div class="ip-editorial-dialog">
          <header class="ip-editorial-header">
            <div>
              <h3 id="ip-editorial-title" class="ip-editorial-heading"></h3>
              <p id="ip-editorial-note" class="ip-editorial-note"></p>
            </div>
            <button id="ip-editorial-close" class="ip-editorial-close" type="button">×</button>
          </header>
          <div id="ip-editorial-list" class="ip-editorial-list"></div>
        </div>
      </div>
    </section>

    <!-- ── ICPC Regionals Section ───────────────────────────── -->
    <section class="page-section" data-view="icpc-regionals">
      <div class="section-header">
        <h2 id="ir-title"></h2>
        <p id="ir-subtitle" class="section-subtitle"></p>
      </div>
      <div id="ir-region-row" class="ip-filter-row"></div>
      <div id="ir-count" class="ip-count"></div>
      <div id="ir-results" class="ip-results"></div>
    </section>

  
      </div><!-- /.site-main-inner -->
    </main>
  </div><!-- /.site-body -->
</div><!-- /.site-app -->

