<script is:inline src={`${base}icpc-prelims/editorials/2023-naq.js`}></script>
<script is:inline src={`${base}icpc-prelims/editorials/2022-23-naq.js`}></script>
<script is:inline src={`${base}icpc-prelims/editorials/2024-south-pacific-prelim-a.js`}></script>
