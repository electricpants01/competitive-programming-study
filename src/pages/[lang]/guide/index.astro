---
import { getLang, useTranslations, getLocalizedUrl, SUPPORTED_LANGS } from '../../../i18n/utils';
import type { Lang } from '../../../i18n/utils';

export function getStaticPaths() {
  return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const enUrl = getLocalizedUrl(Astro.url, 'en');
const esUrl = getLocalizedUrl(Astro.url, 'es');

// Normalize BASE_URL to always have a trailing slash — used for static asset paths
// (nav / lang-switcher use enUrl/esUrl directly; getLocalizedUrl already includes the base)
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!DOCTYPE html>
<html lang={lang} data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    {lang === 'es' ? 'Guía de Programación Competitiva' : 'CP Study Guide — Competitive Programming'}
  </title>
  <meta name="description" content={
    lang === 'es'
      ? 'Guía estructurada de algoritmos, estructuras de datos y técnicas para programación competitiva.'
      : 'A structured guide to algorithms, data structures and techniques for competitive programming.'
  } />
  <!-- Alternate hreflang for SEO -->
  <link rel="alternate" hreflang="en" href={new URL(enUrl, Astro.url).href} />
  <link rel="alternate" hreflang="es" href={new URL(esUrl, Astro.url).href} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
  <!-- Inject translations into window for script.js -->
  <script is:inline define:vars={{ translations: JSON.stringify(t), currentLang: lang }}>
    window.__CP_LANG__ = currentLang;
    window.__CP_T__ = JSON.parse(translations);
  </script>
  <style is:global>
    /* ============================================================
       Design System — tokens for light and dark mode
    ============================================================ */
    :root {
      --color-primary:       #2563eb;
      --color-primary-dark:  #1d4ed8;
      --color-primary-light: #ebf1ff;
      --bg-body:     #eae9df;
      --bg-surface:  #ffffff;
      --bg-sidebar:  #f5f4ed;
      --bg-nav:      #ffffff;
      --bg-code:     #f0efe6;
      --bg-hover:    #dddcd2;
      --bg-active:   #e4ecff;
      --text-primary:   #1a1915;
      --text-secondary: #64625a;
      --text-muted:     #8f8d85;
      --border:       #d4d3c9;
      --shadow-sm: 0 1px 4px rgba(60,58,42,.10);
      --shadow-md: 0 4px 16px rgba(60,58,42,.13);
      --sidebar-width: 240px;
      --nav-height:    56px;
      --radius-sm: 6px;
      --radius-md: 10px;
      --radius-lg: 14px;
      --transition: 200ms ease;
    }
    [data-theme="dark"] {
      --bg-body:     #18181b;
      --bg-surface:  #242428;
      --bg-sidebar:  #1f1f23;
      --bg-nav:      #242428;
      --bg-code:     #18181b;
      --bg-hover:    #2e2d34;
      --bg-active:   #1e3460;
      --text-primary:   #ece8db;
      --text-secondary: #a09d94;
      --text-muted:     #6e6c66;
      --border:       #36343c;
      --color-primary-light: #1e3460;
      --shadow-sm: 0 1px 4px rgba(0,0,0,.28);
      --shadow-md: 0 4px 16px rgba(0,0,0,.40);
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      font-size: 14px;
      line-height: 1.6;
      color: var(--text-primary);
      background: var(--bg-body);
      transition: background var(--transition), color var(--transition);
    }
    /* ── Top Nav ── */
    .top-nav {
      position: fixed; top: 0; left: 0; right: 0;
      height: var(--nav-height);
      background: var(--bg-nav);
      border-bottom: 1px solid var(--border);
      box-shadow: 0 1px 6px rgba(60,58,42,.08);
      display: flex; align-items: center;
      padding: 0 20px; gap: 16px;
      z-index: 100;
      transition: background var(--transition), border-color var(--transition);
    }
    .nav-brand {
      display: flex; align-items: center; gap: 8px;
      font-size: 15px; font-weight: 700;
      color: var(--color-primary);
      text-decoration: none; white-space: nowrap; flex-shrink: 0;
    }
    .nav-links {
      display: flex; align-items: center; gap: 4px;
      flex: 1; justify-content: center;
    }
    .nav-link {
      padding: 6px 16px; border-radius: 20px;
      font-size: 13.5px; font-weight: 500;
      color: var(--text-secondary);
      text-decoration: none; cursor: pointer;
      border: none; background: transparent; white-space: nowrap;
      transition: color var(--transition), background var(--transition);
    }
    .nav-link:hover { color: var(--text-primary); background: var(--bg-hover); }
    .nav-link.active { background: var(--color-primary); color: #fff; }
    .nav-right {
      display: flex; align-items: center; gap: 8px; flex-shrink: 0;
    }
    /* Search */
    .nav-search {
      display: flex; align-items: center; gap: 8px;
      background: var(--bg-body); border: 1px solid var(--border);
      border-radius: 20px; padding: 5px 12px;
      transition: border-color var(--transition), background var(--transition), width var(--transition);
      width: 200px;
    }
    .nav-search:focus-within { border-color: var(--color-primary); width: 260px; }
    .nav-search svg { color: var(--text-muted); flex-shrink: 0; }
    .nav-search input {
      background: transparent; border: none; outline: none;
      font-size: 13px; color: var(--text-primary); width: 100%;
    }
    .nav-search input::placeholder { color: var(--text-muted); }
    .nav-search-clear {
      background: none; border: none; cursor: pointer;
      color: var(--text-muted); display: none; padding: 0; line-height: 1;
    }
    .nav-search-clear:hover { color: var(--text-primary); }
    .nav-search-clear.visible { display: block; }
    /* Lang switcher */
    .lang-switcher {
      display: flex; align-items: center; gap: 2px;
      border: 1px solid var(--border); border-radius: 20px;
      overflow: hidden; flex-shrink: 0;
    }
    .lang-btn {
      padding: 5px 12px;
      font-size: 12px; font-weight: 700;
      letter-spacing: .04em;
      text-decoration: none;
      color: var(--text-secondary);
      transition: background var(--transition), color var(--transition);
      white-space: nowrap;
    }
    .lang-btn:hover { color: var(--text-primary); background: var(--bg-hover); }
    .lang-btn.active { background: var(--color-primary); color: #fff; }
    .lang-divider {
      width: 1px; height: 16px;
      background: var(--border);
      flex-shrink: 0;
    }
    /* Icon btn */
    .icon-btn {
      width: 34px; height: 34px; border-radius: 50%;
      border: none; background: transparent;
      color: var(--text-secondary); cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: background var(--transition), color var(--transition);
    }
    .icon-btn:hover { background: var(--bg-hover); color: var(--text-primary); }
    /* ── Layout ── */
    .layout { display: flex; padding-top: var(--nav-height); min-height: 100vh; }
    /* ── Sidebar ── */
    .sidebar {
      width: var(--sidebar-width);
      background: var(--bg-sidebar);
      border-right: 1px solid var(--border);
      position: fixed; top: var(--nav-height); bottom: 0; left: 0;
      overflow-y: auto; overflow-x: hidden;
      transition: width var(--transition), background var(--transition), border-color var(--transition);
      z-index: 50;
    }
    .sidebar.collapsed { width: 0; }
    .sidebar::-webkit-scrollbar { width: 4px; }
    .sidebar::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
    .sidebar-inner { padding: 16px 0; min-width: var(--sidebar-width); }
    .sidebar-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 16px 12px;
    }
    .sidebar-title { font-size: 12px; font-weight: 700; color: var(--text-primary); letter-spacing: .02em; }
    .sidebar-toggle {
      background: none; border: none; cursor: pointer;
      color: var(--text-secondary); padding: 4px; border-radius: var(--radius-sm);
      transition: background var(--transition);
    }
    .sidebar-toggle:hover { background: var(--bg-hover); }
    .sidebar-progress { padding: 0 16px 16px; }
    .progress-track { height: 4px; background: var(--border); border-radius: 2px; overflow: hidden; margin-bottom: 4px; }
    .progress-fill { height: 100%; background: var(--color-primary); border-radius: 2px; transition: width .4s ease; }
    .progress-label { font-size: 11px; color: var(--text-muted); }
    .sidebar-section { margin-bottom: 8px; }
    .sidebar-section-label {
      padding: 8px 16px 4px;
      font-size: 10.5px; font-weight: 700;
      letter-spacing: .06em; color: var(--text-muted); text-transform: uppercase;
    }
    .sidebar-item {
      display: flex; align-items: center; gap: 8px;
      padding: 7px 16px; font-size: 13px;
      color: var(--text-secondary); cursor: pointer;
      border: none; background: none; width: 100%; text-align: left;
      transition: background var(--transition), color var(--transition);
    }
    .sidebar-item:hover { background: var(--bg-hover); color: var(--text-primary); }
    .sidebar-item.active { background: var(--bg-active); color: var(--color-primary); font-weight: 600; }
    .item-dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--border); flex-shrink: 0; transition: background var(--transition);
    }
    .sidebar-item.active .item-dot { background: var(--color-primary); }
    /* ── Main ── */
    .main { flex: 1; margin-left: var(--sidebar-width); transition: margin-left var(--transition); min-width: 0; }
    .main.sidebar-collapsed { margin-left: 0; }
    /* ── Search overlay ── */
    .search-overlay {
      display: none; position: fixed;
      top: var(--nav-height); left: var(--sidebar-width); right: 0; bottom: 0;
      background: rgba(0,0,0,.4); z-index: 90;
    }
    .search-overlay.visible { display: block; }
    .search-panel {
      background: var(--bg-surface); border-bottom: 1px solid var(--border);
      max-height: 420px; overflow-y: auto; box-shadow: var(--shadow-md);
    }
    .search-results-title {
      padding: 12px 24px 8px; font-size: 11px; font-weight: 700;
      text-transform: uppercase; letter-spacing: .06em; color: var(--text-muted);
    }
    .search-result-item {
      display: flex; flex-direction: column; gap: 2px;
      padding: 10px 24px; cursor: pointer;
      border-bottom: 1px solid var(--border);
      transition: background var(--transition);
    }
    .search-result-item:hover { background: var(--bg-hover); }
    .search-result-item:last-child { border-bottom: none; }
    .search-result-title { font-size: 13px; font-weight: 600; color: var(--text-primary); }
    .search-result-meta { font-size: 11px; color: var(--text-muted); }
    .search-no-results { padding: 24px; text-align: center; color: var(--text-muted); font-size: 13px; }
    /* ── Page sections ── */
    .page-section { display: none; padding: 40px 48px; max-width: 1100px; margin: 0 auto; }
    .page-section.active { display: block; }
    /* ── Hero ── */
    .hero { text-align: center; padding: 48px 24px 40px; }
    .hero-title { font-size: 32px; font-weight: 800; color: var(--text-primary); line-height: 1.2; margin-bottom: 12px; }
    .hero-subtitle { font-size: 15px; color: var(--text-secondary); max-width: 540px; margin: 0 auto 40px; }
    /* Stats */
    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 48px; }
    .stat-card {
      background: var(--bg-surface); border: 1px solid var(--border);
      border-radius: var(--radius-lg); padding: 28px 20px; text-align: center;
      box-shadow: var(--shadow-sm);
      transition: box-shadow var(--transition), transform var(--transition), background var(--transition), border-color var(--transition);
      transition: box-shadow var(--transition), transform var(--transition), background var(--transition), border-color var(--transition);
    }
    .stat-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
    .stat-icon { width: 52px; height: 52px; border-radius: var(--radius-md); background: var(--color-primary); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; font-size: 22px; }
    .stat-number { font-size: 26px; font-weight: 800; color: var(--text-primary); line-height: 1; margin-bottom: 6px; }
    .stat-label { font-size: 12px; color: var(--text-secondary); font-weight: 500; }
    /* Quick nav */
    .section-title { font-size: 20px; font-weight: 700; color: var(--text-primary); text-align: center; margin-bottom: 20px; }
    .quick-nav-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
    .quick-card {
      background: var(--bg-surface); border: 1px solid var(--border);
      border-radius: var(--radius-lg); padding: 28px 16px; text-align: center; cursor: pointer;
      transition: box-shadow var(--transition), transform var(--transition), background var(--transition), border-color var(--transition);
    }
    .quick-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
    .quick-card-icon { font-size: 32px; margin-bottom: 12px; }
    .quick-card-title { font-size: 14px; font-weight: 700; color: var(--text-primary); margin-bottom: 6px; }
    .quick-card-desc { font-size: 12px; color: var(--text-secondary); line-height: 1.5; }
    /* Intro card */
    .intro-card {
      background: var(--bg-surface); border: 1px solid var(--border);
      border-radius: var(--radius-lg); padding: 24px;
      line-height: 1.8; color: var(--text-secondary); font-size: 13.5px;
      transition: background var(--transition), border-color var(--transition);
    }
    .intro-card p { margin-bottom: 12px; }
    .intro-card p:last-child { margin-bottom: 0; }
    /* Learning path */
    .lp-item {
      display: flex; align-items: center; gap: 16px;
      background: var(--bg-surface); border: 1px solid var(--border);
      border-radius: var(--radius-md); padding: 16px 20px;
      transition: background var(--transition), border-color var(--transition);
    }
    .lp-number {
      width: 32px; height: 32px; border-radius: 50%;
      font-weight: 800; display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; font-size: 13px;
    }
    .lp-title { font-weight: 700; color: var(--text-primary); font-size: 13.5px; }
    .lp-desc { font-size: 12px; color: var(--text-secondary); }
    /* ── Algo grid ── */
    .algo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px,1fr)); gap: 16px; }
    .algo-card {
      background: var(--bg-surface); border: 1px solid var(--border);
      border-radius: var(--radius-lg); overflow: hidden; cursor: pointer;
      box-shadow: var(--shadow-sm);
      transition: box-shadow var(--transition), transform var(--transition), background var(--transition), border-color var(--transition);
    }
    .algo-card:hover { box-shadow: var(--shadow-md); transform: translateY(-3px); border-color: var(--color-primary); }
    .algo-card-header { padding: 18px 22px 14px; border-bottom: 1px solid var(--border); }
    .algo-card-title { font-size: 14px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px; }
    .algo-badges { display: flex; gap: 6px; flex-wrap: wrap; }
    .badge { padding: 2px 8px; border-radius: 10px; font-size: 10.5px; font-weight: 600; }
    .badge-category { background: var(--color-primary-light); color: var(--color-primary); }
    .badge-beginner { background: #d1fae5; color: #065f46; }
    .badge-intermediate { background: #fef3c7; color: #92400e; }
    .badge-advanced { background: #fee2e2; color: #991b1b; }
    [data-theme="dark"] .badge-beginner { background: #064e3b; color: #6ee7b7; }
    [data-theme="dark"] .badge-intermediate { background: #451a03; color: #fcd34d; }
    [data-theme="dark"] .badge-advanced { background: #450a0a; color: #fca5a5; }
    .algo-card-body { padding: 16px 22px; }
    .algo-card-desc {
      font-size: 13px; color: var(--text-secondary); line-height: 1.65; margin-bottom: 12px;
      display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
    }
    .algo-card-meta { display: flex; gap: 12px; }
    .algo-meta-item { font-size: 11px; color: var(--text-muted); display: flex; align-items: center; gap: 4px; }
    /* ── Modal ── */
    .modal-backdrop {
      display: none; position: fixed; inset: 0;
      background: rgba(0,0,0,.5); z-index: 200;
      padding: 20px; overflow-y: auto;
    }
    .modal-backdrop.visible { display: flex; align-items: flex-start; justify-content: center; }
    .modal {
      background: var(--bg-surface); border-radius: var(--radius-lg);
      width: 100%; max-width: 760px; margin: auto;
      overflow: hidden; box-shadow: var(--shadow-md);
    }
    .modal-header {
      display: flex; align-items: flex-start; justify-content: space-between;
      padding: 24px 28px 20px; border-bottom: 1px solid var(--border); gap: 16px;
    }
    .modal-title { font-size: 20px; font-weight: 800; color: var(--text-primary); margin-bottom: 8px; }
    .modal-close {
      background: none; border: none; cursor: pointer;
      color: var(--text-muted); padding: 4px; border-radius: var(--radius-sm);
      transition: background var(--transition), color var(--transition); flex-shrink: 0;
    }
    .modal-close:hover { background: var(--bg-hover); color: var(--text-primary); }
    .modal-body { padding: 24px 28px; }
    .modal-section { margin-bottom: 28px; }
    .modal-section:last-child { margin-bottom: 0; }
    .modal-section-title {
      font-size: 12px; font-weight: 700; text-transform: uppercase;
      letter-spacing: .06em; color: var(--text-muted); margin-bottom: 10px;
    }
    .modal-desc { font-size: 13.5px; color: var(--text-secondary); line-height: 1.7; }
    .tag-list { display: flex; flex-wrap: wrap; gap: 6px; }
    .tag {
      padding: 4px 10px; background: var(--bg-surface); border: 1px solid var(--border);
      border-radius: var(--radius-sm); font-size: 12px; color: var(--text-secondary);
    }
    .bullet-list { list-style: none; display: flex; flex-direction: column; gap: 6px; }
    .bullet-list li { font-size: 13px; color: var(--text-secondary); display: flex; align-items: flex-start; gap: 8px; line-height: 1.5; }
    .bullet-list li::before { content: "•"; color: var(--color-primary); font-weight: 700; flex-shrink: 0; margin-top: 1px; }
    .code-example { background: var(--bg-code); border: 1px solid var(--border); border-radius: var(--radius-md); overflow: hidden; margin-bottom: 12px; }
    .code-example-header { display: flex; justify-content: space-between; align-items: center; padding: 10px 16px; border-bottom: 1px solid var(--border); }
    .code-example-title { font-size: 12px; font-weight: 700; color: var(--text-primary); }
    .code-copy-btn {
      background: none; border: 1px solid var(--border); border-radius: var(--radius-sm);
      padding: 3px 10px; font-size: 11px; color: var(--text-secondary); cursor: pointer;
      transition: background var(--transition), color var(--transition);
    }
    .code-copy-btn:hover { background: var(--bg-hover); color: var(--text-primary); }
    .code-copy-btn.copied { color: #10b981; border-color: #10b981; }
    .code-block {
      padding: 16px; overflow-x: auto;
      font-family: 'JetBrains Mono', 'Fira Code', monospace;
      font-size: 12px; line-height: 1.7; color: var(--text-primary); white-space: pre;
    }
    .ascii-art {
      padding: 16px; overflow-x: auto;
      font-family: 'JetBrains Mono', 'Fira Code', monospace;
      font-size: 12px; line-height: 1.6; color: var(--color-primary);
      background: var(--bg-body); border: 1px solid var(--border);
      border-radius: var(--radius-sm); white-space: pre; margin: 0;
    }
    .problems-list { display: flex; flex-wrap: wrap; gap: 8px; }
    .problem-chip {
      padding: 5px 12px; background: var(--color-primary-light);
      color: var(--color-primary); border-radius: 14px;
      font-size: 12px; font-weight: 500; cursor: pointer;
      transition: background var(--transition);
    }
    .problem-chip:hover { background: var(--color-primary); color: #fff; }
    /* Visualizer links */
    .visualizer-links { display: flex; flex-wrap: wrap; gap: 8px; }

    /* ── Quiz styles ─────────────────────────────────────────── */
    .quiz-section { border-top: 2px solid var(--color-primary-light); }
    .quiz-body { display: flex; flex-direction: column; gap: 20px; }
    .quiz-question { display: flex; flex-direction: column; gap: 8px; }
    .quiz-q-text { font-size: 14px; font-weight: 600; color: var(--text-primary); line-height: 1.5; }
    .quiz-options { display: flex; flex-direction: column; gap: 6px; }
    .quiz-option {
      text-align: left; background: var(--bg-body); border: 1.5px solid var(--border);
      border-radius: var(--radius-sm); padding: 8px 12px;
      font-size: 13px; color: var(--text-primary); cursor: pointer;
      transition: border-color var(--transition), background var(--transition);
    }
    .quiz-option:hover:not(:disabled) { border-color: var(--color-primary); background: var(--bg-active); }
    .quiz-option.selected { border-color: var(--color-primary); background: var(--color-primary-light); font-weight: 600; }
    .quiz-option.correct { border-color: #16a34a; background: #dcfce7; color: #14532d; font-weight: 600; }
    .quiz-option.wrong   { border-color: #dc2626; background: #fee2e2; color: #7f1d1d; }
    .quiz-option:disabled { cursor: default; opacity: 0.9; }
    .quiz-feedback { font-size: 12.5px; font-weight: 600; padding: 4px 0; }
    .quiz-feedback-correct { color: #16a34a; }
    .quiz-feedback-wrong   { color: #dc2626; }
    .quiz-feedback-miss    { color: #d97706; }
    .quiz-footer { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 4px; }
    .quiz-submit-btn, .quiz-retry-btn {
      padding: 9px 20px; border-radius: var(--radius-sm);
      font-size: 13.5px; font-weight: 600; cursor: pointer; border: none;
      transition: opacity var(--transition);
    }
    .quiz-submit-btn { background: var(--color-primary); color: #fff; }
    .quiz-submit-btn:hover { opacity: 0.88; }
    .quiz-retry-btn { background: var(--bg-body); border: 1.5px solid var(--border); color: var(--text-primary); }
    .quiz-retry-btn:hover { border-color: var(--color-primary); }
    .quiz-score {
      font-size: 14px; font-weight: 700; color: var(--color-primary);
      background: var(--color-primary-light); border-radius: var(--radius-sm);
      padding: 7px 14px; align-items: center;
    }
    [data-theme="dark"] .quiz-option.correct { background: #14532d; color: #bbf7d0; border-color: #16a34a; }
    [data-theme="dark"] .quiz-option.wrong   { background: #7f1d1d; color: #fecaca; border-color: #dc2626; }
    [data-theme="dark"] .quiz-option.selected { background: #1e3a8a; color: #bfdbfe; border-color: var(--color-primary); }
    .viz-link {
      display: inline-flex; align-items: center; gap: 5px;
      padding: 6px 14px;
      background: var(--bg-body);
      border: 1px solid var(--color-primary);
      border-radius: 20px;
      font-size: 12px; font-weight: 600;
      color: var(--color-primary);
      text-decoration: none;
      transition: background var(--transition), color var(--transition), border-color var(--transition);
    }
    .viz-link:hover { background: var(--color-primary); color: #fff; }
    /* ── Roadmap ── */
    .roadmap-phases { display: flex; flex-direction: column; gap: 24px; }
    .roadmap-phase { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; transition: background var(--transition), border-color var(--transition); }
    .roadmap-phase-header { display: flex; align-items: center; gap: 16px; padding: 20px 24px; border-bottom: 1px solid var(--border); }
    .phase-number { width: 36px; height: 36px; border-radius: 50%; background: var(--color-primary); color: #fff; font-size: 14px; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .phase-title { font-size: 16px; font-weight: 700; color: var(--text-primary); }
    .phase-duration { font-size: 12px; color: var(--text-muted); }
    .phase-body { padding: 20px 24px; display: grid; grid-template-columns: repeat(auto-fill, minmax(180px,1fr)); gap: 12px; }
    .phase-topic { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--text-secondary); }
    .phase-topic-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-primary); flex-shrink: 0; }
    /* ── Tools ── */
    .tools-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px,1fr)); gap: 16px; }
    .tool-card { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 20px; transition: box-shadow var(--transition), background var(--transition), border-color var(--transition); }
    .tool-card:hover { box-shadow: var(--shadow-md); }
    .tool-card-icon { font-size: 28px; margin-bottom: 12px; }
    .tool-card-title { font-size: 14px; font-weight: 700; color: var(--text-primary); margin-bottom: 6px; }
    .tool-card-desc { font-size: 12.5px; color: var(--text-secondary); line-height: 1.6; margin-bottom: 12px; }
    .tool-card-link { font-size: 12px; font-weight: 600; color: var(--color-primary); text-decoration: none; display: inline-flex; align-items: center; gap: 4px; }
    .tool-card-link:hover { text-decoration: underline; }
    .tools-section-label { font-size: 14px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 16px; margin-top: 32px; }
    .tools-section-label:first-child { margin-top: 0; }
    /* ── Detail panel ── */
    .detail-back-btn {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 7px 16px; margin-bottom: 24px;
      background: none; border: 1px solid var(--border);
      border-radius: 20px; cursor: pointer;
      font-size: 13px; font-weight: 500; color: var(--text-secondary);
      transition: background var(--transition), color var(--transition), border-color var(--transition);
    }
    .detail-back-btn:hover { background: var(--bg-hover); color: var(--text-primary); }
    .detail-card {
      background: var(--bg-surface); border: 1px solid var(--border);
      border-radius: var(--radius-lg); overflow: hidden;
      box-shadow: var(--shadow-md); max-width: 760px; margin: 0 auto;
      transition: background var(--transition), border-color var(--transition);
    }
    /* ── Responsive ── */
    @media (max-width: 1024px) { .stats-grid, .quick-nav-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 768px) {
      .sidebar { transform: translateX(-100%); }
      .sidebar.mobile-open { transform: translateX(0); width: var(--sidebar-width); }
      .main { margin-left: 0 !important; }
      .page-section { padding: 24px 20px; }
      .nav-search { width: 140px; }
      .hero-title { font-size: 24px; }
      .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
      .quick-nav-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 480px) { .nav-links { display: none; } }
  </style>
</head>
<body>

<!-- ═══ TOP NAV ═══ -->
<nav class="top-nav">
  <a class="nav-brand" href={`${base}${lang}/guide`}>
    <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
      <rect width="28" height="28" rx="8" fill="#2563eb"/>
      <text x="5" y="20" font-family="monospace" font-size="14" font-weight="800" fill="white">&lt;/&gt;</text>
    </svg>
    {t.nav.brand}
  </a>

  <div class="nav-links">
    <button class="nav-link active" data-section="overview">{t.nav.overview}</button>
    <button class="nav-link" data-section="algorithms">{t.nav.algorithms}</button>
    <button class="nav-link" data-section="roadmap">{t.nav.roadmap}</button>
    <button class="nav-link" data-section="tools">{t.nav.tools}</button>
  </div>

  <div class="nav-right">
    <!-- Search -->
    <div class="nav-search">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input id="search-input" type="text" placeholder={t.nav.searchPlaceholder} autocomplete="off" spellcheck="false" />
      <button class="nav-search-clear" id="search-clear" aria-label="Clear search">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <!-- Language switcher -->
    <div class="lang-switcher" role="navigation" aria-label="Language">
      <a class:list={['lang-btn', { active: lang === 'en' }]} href={enUrl} hreflang="en">EN</a>
      <span class="lang-divider" aria-hidden="true"></span>
      <a class:list={['lang-btn', { active: lang === 'es' }]} href={esUrl} hreflang="es">ES</a>
    </div>

    <!-- Dark/Light toggle -->
    <button class="icon-btn" id="theme-toggle" title={t.nav.toggleTheme}>
      <span id="theme-icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </span>
    </button>
  </div>
</nav>

<!-- ═══ LAYOUT ═══ -->
<div class="layout">

  <!-- Sidebar -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-inner">
      <div class="sidebar-header">
        <span class="sidebar-title">{t.sidebar.title}</span>
        <button class="sidebar-toggle" id="sidebar-toggle" title="Collapse">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="transition:transform 200ms ease">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
        </button>
      </div>
      <div class="sidebar-progress">
        <div class="progress-track"><div class="progress-fill" id="progress-fill" style="width:0%"></div></div>
        <div class="progress-label" id="progress-label">0%</div>
      </div>
      <div id="sidebar-nav"></div>
    </div>
  </aside>

  <!-- Main -->
  <main class="main" id="main">

    <!-- Search overlay -->
    <div class="search-overlay" id="search-overlay">
      <div class="search-panel" id="search-results"></div>
    </div>

    <!-- ══ OVERVIEW ══ -->
    <section class="page-section active" data-section="overview">
      <div class="hero">
        <h1 class="hero-title">
          {t.overview.heroTitle.split('\n').map((line, i) => (
            <>{line}{i < t.overview.heroTitle.split('\n').length - 1 && <br/>}</>
          ))}
        </h1>
        <p class="hero-subtitle">{t.overview.heroSubtitle}</p>
      </div>

      <div class="stats-grid">
        <div class="stat-card"><div class="stat-icon">📚</div><div class="stat-number">50+</div><div class="stat-label">{t.overview.stats.algorithms}</div></div>
        <div class="stat-card"><div class="stat-icon">⚡</div><div class="stat-number">9</div><div class="stat-label">{t.overview.stats.categories}</div></div>
        <div class="stat-card"><div class="stat-icon">🏆</div><div class="stat-number">500+</div><div class="stat-label">{t.overview.stats.problems}</div></div>
        <div class="stat-card"><div class="stat-icon">🚀</div><div class="stat-number">2025</div><div class="stat-label">{t.overview.stats.stateOfTheArt}</div></div>
      </div>

      <h2 class="section-title">{t.overview.quickNav.title}</h2>
      <div class="quick-nav-grid">
        <div class="quick-card" data-goto="overview">
          <div class="quick-card-icon">📊</div>
          <div class="quick-card-title">{t.overview.quickNav.assess.title}</div>
          <div class="quick-card-desc">{t.overview.quickNav.assess.desc}</div>
        </div>
        <div class="quick-card" data-goto="algorithms">
          <div class="quick-card-icon">🔍</div>
          <div class="quick-card-title">{t.overview.quickNav.explore.title}</div>
          <div class="quick-card-desc">{t.overview.quickNav.explore.desc}</div>
        </div>
        <div class="quick-card" data-goto="roadmap">
          <div class="quick-card-icon">🗺️</div>
          <div class="quick-card-title">{t.overview.quickNav.roadmap.title}</div>
          <div class="quick-card-desc">{t.overview.quickNav.roadmap.desc}</div>
        </div>
        <div class="quick-card" data-goto="tools">
          <div class="quick-card-icon">🛠️</div>
          <div class="quick-card-title">{t.overview.quickNav.tools.title}</div>
          <div class="quick-card-desc">{t.overview.quickNav.tools.desc}</div>
        </div>
      </div>

      <div style="margin-top:40px" id="overview-introduction">
        <h2 class="section-title" style="text-align:left;margin-bottom:16px">{t.overview.introTitle}</h2>
        <div class="intro-card">
          {t.overview.introBody.map(p => <p>{p}</p>)}
        </div>
      </div>

      <div style="margin-top:32px" id="overview-learning-path">
        <h2 class="section-title" style="text-align:left;margin-bottom:16px">{t.overview.learningPathTitle}</h2>
        <div style="display:flex;flex-direction:column;gap:12px">
          {t.overview.learningPath.map(item => (
            <div class="lp-item">
              <div class="lp-number" style={`background:${item.color};color:${item.textColor}`}>{item.step}</div>
              <div>
                <div class="lp-title">{item.title}</div>
                <div class="lp-desc">{item.desc}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══ ALGORITHMS ══ -->
    <section class="page-section" data-section="algorithms">
      <div style="margin-bottom:24px">
        <h2 style="font-size:22px;font-weight:800;color:var(--text-primary);margin-bottom:6px">{t.algorithms.title}</h2>
        <p style="font-size:13.5px;color:var(--text-secondary)">{t.algorithms.subtitle}</p>
      </div>
      <div class="algo-grid" id="algo-grid"></div>
    </section>

    <!-- ══ ROADMAP ══ -->
    <section class="page-section" data-section="roadmap">
      <div style="margin-bottom:28px">
        <h2 style="font-size:22px;font-weight:800;color:var(--text-primary);margin-bottom:6px">{t.roadmap.title}</h2>
        <p style="font-size:13.5px;color:var(--text-secondary)">{t.roadmap.subtitle}</p>
      </div>
      <div class="roadmap-phases">
        {t.roadmap.phases.map(phase => (
          <div class="roadmap-phase">
            <div class="roadmap-phase-header">
              <div class="phase-number">{phase.number}</div>
              <div>
                <div class="phase-title">{phase.title}</div>
                <div class="phase-duration">{phase.duration}</div>
              </div>
            </div>
            <div class="phase-body">
              {phase.topics.map(topic => (
                <div class="phase-topic">
                  <span class="phase-topic-dot"></span>{topic}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ══ DETAIL ══ -->
    <section class="page-section" data-section="detail">
      <button class="detail-back-btn" id="detail-back">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
        {lang === 'es' ? 'Volver a Algoritmos' : 'Back to Algorithms'}
      </button>
      <div id="detail-panel"></div>
    </section>

    <!-- ══ TOOLS ══ -->
    <section class="page-section" data-section="tools">
      <div style="margin-bottom:28px">
        <h2 style="font-size:22px;font-weight:800;color:var(--text-primary);margin-bottom:6px">{t.tools.title}</h2>
        <p style="font-size:13.5px;color:var(--text-secondary)">{t.tools.subtitle}</p>
      </div>

      <div class="tools-section-label">{t.tools.sections.judges}</div>
      <div class="tools-grid">
        <div class="tool-card"><div class="tool-card-icon">⚔️</div><div class="tool-card-title">{t.tools.items.codeforces.title}</div><div class="tool-card-desc">{t.tools.items.codeforces.desc}</div><a class="tool-card-link" href="https://codeforces.com" target="_blank" rel="noopener">{t.tools.visitLabel}</a></div>
        <div class="tool-card"><div class="tool-card-icon">💡</div><div class="tool-card-title">{t.tools.items.leetcode.title}</div><div class="tool-card-desc">{t.tools.items.leetcode.desc}</div><a class="tool-card-link" href="https://leetcode.com" target="_blank" rel="noopener">{t.tools.visitLabel}</a></div>
        <div class="tool-card"><div class="tool-card-icon">🎌</div><div class="tool-card-title">{t.tools.items.atcoder.title}</div><div class="tool-card-desc">{t.tools.items.atcoder.desc}</div><a class="tool-card-link" href="https://atcoder.jp" target="_blank" rel="noopener">{t.tools.visitLabel}</a></div>
        <div class="tool-card"><div class="tool-card-icon">🌍</div><div class="tool-card-title">{t.tools.items.cses.title}</div><div class="tool-card-desc">{t.tools.items.cses.desc}</div><a class="tool-card-link" href="https://cses.fi/problemset" target="_blank" rel="noopener">{t.tools.visitLabel}</a></div>
      </div>

      <div class="tools-section-label">{t.tools.sections.learning}</div>
      <div class="tools-grid">
        <div class="tool-card"><div class="tool-card-icon">📖</div><div class="tool-card-title">{t.tools.items.cpAlgorithms.title}</div><div class="tool-card-desc">{t.tools.items.cpAlgorithms.desc}</div><a class="tool-card-link" href="https://cp-algorithms.com" target="_blank" rel="noopener">{t.tools.visitLabel}</a></div>
        <div class="tool-card"><div class="tool-card-icon">📚</div><div class="tool-card-title">{t.tools.items.usacoGuide.title}</div><div class="tool-card-desc">{t.tools.items.usacoGuide.desc}</div><a class="tool-card-link" href="https://usaco.guide" target="_blank" rel="noopener">{t.tools.visitLabel}</a></div>
        <div class="tool-card"><div class="tool-card-icon">🎥</div><div class="tool-card-title">{t.tools.items.errichto.title}</div><div class="tool-card-desc">{t.tools.items.errichto.desc}</div><a class="tool-card-link" href="https://youtube.com/@Errichto" target="_blank" rel="noopener">{t.tools.visitLabel}</a></div>
        <div class="tool-card"><div class="tool-card-icon">📝</div><div class="tool-card-title">{t.tools.items.cpHandbook.title}</div><div class="tool-card-desc">{t.tools.items.cpHandbook.desc}</div><a class="tool-card-link" href="https://cses.fi/book/book.pdf" target="_blank" rel="noopener">{t.tools.downloadLabel}</a></div>
      </div>

      <div class="tools-section-label">{t.tools.sections.dev}</div>
      <div class="tools-grid">
        <div class="tool-card"><div class="tool-card-icon">💻</div><div class="tool-card-title">{t.tools.items.vscode.title}</div><div class="tool-card-desc">{t.tools.items.vscode.desc}</div><a class="tool-card-link" href="https://github.com/jmerle/competitive-companion" target="_blank" rel="noopener">{t.tools.githubLabel}</a></div>
        <div class="tool-card"><div class="tool-card-icon">🔧</div><div class="tool-card-title">{t.tools.items.gdb.title}</div><div class="tool-card-desc">{t.tools.items.gdb.desc}</div><a class="tool-card-link" href="https://gcc.gnu.org/onlinedocs/gcc/Instrumentation-Options.html" target="_blank" rel="noopener">{t.tools.docsLabel}</a></div>
        <div class="tool-card"><div class="tool-card-icon">🖊️</div><div class="tool-card-title">{t.tools.items.stlCheatsheet.title}</div><div class="tool-card-desc">{t.tools.items.stlCheatsheet.desc}</div><a class="tool-card-link" href="https://hackingcpp.com/cpp/cheat_sheets.html" target="_blank" rel="noopener">{t.tools.viewLabel}</a></div>
        <div class="tool-card"><div class="tool-card-icon">📈</div><div class="tool-card-title">{t.tools.items.cfTracker.title}</div><div class="tool-card-desc">{t.tools.items.cfTracker.desc}</div><a class="tool-card-link" href="https://cftracker.netlify.app" target="_blank" rel="noopener">{t.tools.visitLabel}</a></div>
      </div>
    </section>

  </main>
</div>

<script is:inline src={`${base}algorithms-data-${lang}.js`}></script>
<script is:inline src={`${base}guide-script.js`}></script>
</body>
</html>